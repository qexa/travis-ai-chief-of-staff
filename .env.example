# ─── Travis Core configuration ─────────────────────────────────────────────
# Copy to .env. Everything is optional: with no keys the server runs in DEMO
# MODE (local calendar, SMS/email printed to the console, rule-based commands).

# Core
TRAVIS_PROFILE=config/executive.example.yaml
TRAVIS_DB=travis.db
TRAVIS_KNOWLEDGE_DIR=knowledge/example
PUBLIC_BASE_URL=https://travis.yourdomain.com     # public https URL of this server
TRAVIS_ADMIN_TOKEN=                               # protects /admin, /tools, /briefing, /exec (set in prod!)
TRAVIS_SCHEDULER=true                             # in-process morning briefing + reminders
# TRAVIS_FAKE_NOW=2026-10-05T13:30:00             # freeze the clock (demos/tests only)

# Voice platform (Vapi reference build)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=                              # same value Vapi sends as x-vapi-secret (set in prod!)
VAPI_ASSISTANT_ID=                                # printed by scripts/deploy_vapi.py

# Calendar: demo | google
CALENDAR_BACKEND=demo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=                             # scripts/google_oauth.py
GOOGLE_CALENDAR_ID=primary

# SMS (Twilio). Needs an A2P 10DLC-registered number in the US.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true

# Email (any SMTP: Google Workspace, Microsoft 365, Resend, Postmark, SES…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=travis@yourdomain.com

# LLM for the executive text channel ("Ask TRAVIS anything")
ANTHROPIC_API_KEY=
TRAVIS_LLM_MODEL=claude-sonnet-5
